{
  "name": "@hawknext/llmapi-adapter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "HawkNext LLMAPI adapter — sole model egress (Auto/mimo), failover, reasoning normalize",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "test": "node --test test/unit/*.test.ts",
    "test:unit": "node --test test/unit/*.test.ts",
    "test:p1": "node --test test/integration/p1-four-cases.test.ts",
    "test:all": "node --test test/unit/*.test.ts test/integration/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=22"
  }
}
